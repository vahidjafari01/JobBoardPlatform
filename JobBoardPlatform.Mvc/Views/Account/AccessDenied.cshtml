@{
    ViewData["Title"] = "Access Denied";
}

<div class="card shadow-sm mx-auto text-center" style="max-width: 480px;">
    <div class="card-body p-5">
        <div class="mx-auto mb-3" style="width:84px; height:84px; border-radius:50%; background:#fef3c7; display:grid; place-items:center;">
            <i class="bi bi-shield-lock" style="font-size:2.5rem; color:#d97706;"></i>
        </div>
        <h3 class="fw-bold mb-2">Access Denied</h3>
        <p class="text-muted mb-4">You do not have permission to access this page.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Back to Home</a>
    </div>
</div>
