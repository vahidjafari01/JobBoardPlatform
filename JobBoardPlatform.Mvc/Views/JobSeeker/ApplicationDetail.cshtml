@model JobBoardPlatfomr.Services.OutPutDtos.AppDetailForJobSeeker
@{
    ViewData["Title"] = "Application Detail";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="mx-auto mb-3" style="width:84px; height:84px; border-radius:50%; background:var(--brand-light); display:grid; place-items:center;">
                        <i class="bi bi-check2-circle" style="font-size:2.3rem; color:var(--brand);"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Application Status</h4>
                    <span class="badge text-bg-@(Model.Status switch
                    {
                        "Accepted" => "success",
                        "Rejected" => "danger",
                        "Canceled" => "secondary",
                        "Interview" => "info",
                        "InReview" => "warning",
                        _ => "primary"
                    })" style="font-size:.95rem;">
                        @Model.Status
                    </span>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Reviewed At</dt>
                    <dd class="col-sm-8">@(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Modified At</dt>
                    <dd class="col-sm-8">@(Model.ModifiedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Your Note</dt>
                    <dd class="col-sm-8">@(Model.NoteWritenByUser ?? "-")</dd>
                </dl>
                <div class="mt-4 d-flex flex-wrap gap-2">
                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@Model.JobAdId" class="btn btn-primary rounded-pill"><i class="bi bi-eye me-1"></i>View Job</a>
                    @if (Model.ResumeId.HasValue)
                    {
                        <a asp-controller="JobSeeker" asp-action="DownloadResume" asp-route-appId="@Model.AppId" class="btn btn-outline-primary rounded-pill">
                            <i class="bi bi-download me-1"></i>My Resume
                        </a>
                    }
                    <a asp-controller="JobSeeker" asp-action="MyApplications" class="btn btn-secondary rounded-pill"><i class="bi bi-arrow-left me-1"></i>Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
