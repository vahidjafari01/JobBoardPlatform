@model HomeIndexViewModel
@{
    ViewData["Title"] = "Job Ads";
    string TypeIcon(string type) => type switch
    {
        "FullTime" => "bi bi-clock",
        "PartTime" => "bi bi-hourglass-split",
        "Remote" => "bi bi-laptop",
        "Contract" => "bi bi-file-earmark-text",
        _ => "bi bi-briefcase"
    };
}

<div class="hero mb-4">
    <div class="position-relative" style="z-index:1;">
        <div class="text-center mb-4">
            <span class="badge text-bg-light mb-2">+@Model.Ads.Count().ToString() active jobs</span>
            <h1 class="display-5">Find your dream job</h1>
            <p class="lead opacity-75 mb-0">Browse thousands of opportunities from top companies.</p>
        </div>

        <form method="get" asp-controller="Home" asp-action="Index" class="hero-search mx-auto" style="max-width: 720px;">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-search text-primary"></i></span>
                        <input class="form-control" type="text" placeholder="Search by title..." asp-for="Filter.Title" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" asp-for="Filter.CategoryId" asp-items="Model.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" asp-for="Filter.ProvinceId" asp-items="Model.Provinces">
                        <option value="">All Provinces</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Ads.Any())
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 fw-bold">Latest Job Opportunities</h5>
        <span class="text-muted small">@Model.Ads.Count() results</span>
    </div>
}

<div class="row g-3">
    @if (!Model.Ads.Any())
    {
        <div class="col-12">
            <div class="text-center py-5">
                <i class="bi bi-search" style="font-size: 3rem; color: #cbd5e1;"></i>
                <h5 class="mt-3">No job ads found</h5>
                <p class="text-muted mb-0">Try adjusting your search filters.</p>
            </div>
        </div>
    }
    @foreach (var ad in Model.Ads)
    {
        <div class="col-md-4">
            <div class="card job-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        @if (ad.LogoId.HasValue)
                        {
                            <img src="/api/Attach/@ad.LogoId" alt="logo" class="rounded-3 border" style="width:52px; height:52px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar">
                                <i class="bi bi-buildings"></i>
                            </div>
                        }
                        @if (ad.IsFeatured)
                        {
                            <span class="badge text-bg-warning"><i class="bi bi-star-fill me-1"></i>Featured</span>
                        }
                    </div>

                    <h5 class="card-title mb-1">
                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@ad.JobAdId" class="text-decoration-none">@ad.Title</a>
                    </h5>

                    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
                        <span class="meta-chip">
                            <i class="@TypeIcon(ad.EmployementType ?? "")"></i>
                            @ad.EmployementType
                        </span>
                        <span class="meta-chip">
                            <i class="bi bi-cash-coin"></i>
                            @if (ad.SalaryMin.HasValue && ad.SalaryMax.HasValue)
                            {
                                <text>@ad.SalaryMin.Value.ToString("N0") - @ad.SalaryMax.Value.ToString("N0")</text>
                            }
                            else
                            {
                                <text>Negotiable</text>
                            }
                        </span>
                    </div>

                    <div class="mt-auto">
                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@ad.JobAdId" class="btn btn-outline-primary w-100 rounded-pill">
                            View Details <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Ads.Any())
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Paging.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Home" asp-action="Index"
                   asp-route-page="@(Model.Paging.PageNumber - 1)"
                   asp-route-title="@Model.Filter.Title"
                   asp-route-provinceId="@Model.Filter.ProvinceId"
                   asp-route-categoryId="@Model.Filter.CategoryId">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            <li class="page-item active">
                <span class="page-link">@Model.Paging.PageNumber</span>
            </li>
            <li class="page-item">
                <a class="page-link" asp-controller="Home" asp-action="Index"
                   asp-route-page="@(Model.Paging.PageNumber + 1)"
                   asp-route-title="@Model.Filter.Title"
                   asp-route-provinceId="@Model.Filter.ProvinceId"
                   asp-route-categoryId="@Model.Filter.CategoryId">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
