@model JobBoardPlatfomr.Services.OutPutDtos.JobAdDetailForCustomer
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div class="d-flex align-items-start gap-3">
                        @if (Model.LogoId.HasValue)
                        {
                            <img src="/api/Attach/@Model.LogoId" alt="logo" class="rounded-3 border" style="width:64px; height:64px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar" style="width:64px; height:64px; font-size:1.6rem;">
                                <i class="bi bi-buildings"></i>
                            </div>
                        }
                        <div>
                            <h2 class="mb-1 fw-bold">@Model.Title</h2>
                            <span class="company-badge"><i class="bi bi-building"></i> @Model.CompanyName</span>
                        </div>
                    </div>
                    @if (Model.Status == "Active")
                    {
                        <span class="badge text-bg-success">Open</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@Model.Status</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="meta-chip"><i class="bi bi-geo-alt"></i> @(Model.CompanyLocation ?? "-")</span>
                    <span class="meta-chip"><i class="bi bi-tag"></i> @Model.CategoryName</span>
                    <span class="meta-chip"><i class="bi bi-briefcase"></i> @Model.EmployementType</span>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span class="meta-chip"><i class="bi bi-geo"></i> @Model.Location</span>
                    }
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="detail-stat">
                            <div class="ds-icon"><i class="bi bi-cash-coin"></i></div>
                            <div class="ds-label mb-1">Salary</div>
                            <div class="ds-value">
                                @if (Model.SalaryMin.HasValue && Model.SalaryMax.HasValue)
                                {
                                    <text>@Model.SalaryMin.Value.ToString("N0") - @Model.SalaryMax.Value.ToString("N0")</text>
                                }
                                else
                                {
                                    <text>Negotiable</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-stat">
                            <div class="ds-icon"><i class="bi bi-clock"></i></div>
                            <div class="ds-label mb-1">Working Hours</div>
                            <div class="ds-value">@Model.StartWorkTime.ToString(@"hh\:mm") - @Model.EndWorkTIme.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-stat">
                            <div class="ds-icon"><i class="bi bi-check2-circle"></i></div>
                            <div class="ds-label mb-1">Employment Type</div>
                            <div class="ds-value">@Model.EmployementType</div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-2"><i class="bi bi-card-text me-2 text-primary"></i>Job Description</h5>
                <p class="text-muted lh-lg">@Model.Description</p>

                @if (Model.Skils is { Count: > 0 })
                {
                    <h5 class="fw-bold mb-2"><i class="bi bi-tools me-2 text-primary"></i>Required Skills</h5>
                    <div>
                        @foreach (var skill in Model.Skils)
                        {
                            <span class="skill-pill"><i class="bi bi-check2 me-1"></i>@skill</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-buildings me-2 text-primary"></i>About the Company</h5>
                <p class="text-muted lh-lg">@(Model.CompanyDescription ?? "This company hasn't added a description yet.")</p>
                @if (!string.IsNullOrEmpty(Model.CompanyWebSite))
                {
                    <a href="@Model.CompanyWebSite" target="_blank" class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-globe me-1"></i> Visit Website
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm sticky-lg-top" style="top: 1rem;">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-send me-2 text-primary"></i>Apply for this job</h5>
            </div>
            <div class="card-body">
                @if (User.IsInRole("JobSeeker"))
                {
                    <form method="post" asp-controller="JobSeeker" asp-action="Apply">
                        <input type="hidden" name="jobAdId" value="@((Guid)ViewData["JobAdId"]!)" />
                        <div class="mb-3">
                            <label class="form-label">Cover Note <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea class="form-control" name="note" rows="4" placeholder="Tell the employer why you're a great fit..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100 rounded-pill py-2">
                            <i class="bi bi-send-fill me-2"></i>Submit Application
                        </button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-info-circle me-2"></i>Only job seekers can apply. You are signed in as a non-job-seeker account.
                    </div>
                }
                else
                {
                    <p class="text-muted">Sign in as a job seeker to apply for this job.</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary w-100 rounded-pill py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login to Apply
                    </a>
                    <hr />
                    <p class="text-center mb-0 small text-muted">
                        New here? <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Create an account</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>
