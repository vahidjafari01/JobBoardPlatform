@model List<JobBoardPlatfomr.Services.OutPutDtos.JobAdDto>
@{
    ViewData["Title"] = "Job Ads";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-card-list me-2 text-primary"></i>All Job Ads</h4>
    <span class="badge text-bg-primary">@Model.Count() ads</span>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ad in Model)
                {
                    <tr>
                        <td class="fw-semibold">@ad.Title</td>
                        <td>
                            <span class="badge text-bg-@(ad.Status == "Active" ? "success" : ad.Status == "Closed" ? "danger" : "secondary")">
                                @ad.Status
                            </span>
                        </td>
                        <td>
                            @if (ad.IsFeatured)
                            {
                                <span class="badge text-bg-warning"><i class="bi bi-star-fill me-1"></i>Featured</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light text-muted">Normal</span>
                            }
                        </td>
                        <td class="text-end" style="white-space:nowrap;">
                            <form method="post" asp-controller="Admin" asp-action="ActivateJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success rounded-pill">Activate</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="ArchiveJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-warning rounded-pill">Archive</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="CloseJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger rounded-pill">Close</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="MakeNormalJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill">Normal</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="MakeProJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill">Pro</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="MakePlusJobAd" asp-route-jobAdId="@ad.JobAdId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill">Plus</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
