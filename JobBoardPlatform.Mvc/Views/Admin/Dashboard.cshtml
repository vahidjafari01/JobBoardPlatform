@model JobBoardPlatfomr.Services.OutPutDtos.AdminDashbordDto
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h4><i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Dashboard</h4>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="JobSeekers" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-people me-1"></i>Job Seekers</a>
        <a asp-controller="Admin" asp-action="Employers" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-building me-1"></i>Employers</a>
        <a asp-controller="Admin" asp-action="JobAds" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-card-list me-1"></i>Job Ads</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-indigo text-white"><i class="bi bi-briefcase"></i></div>
                <div class="stat-value">@Model.ActiveJobAdsCount</div>
                <div class="stat-label">Active Job Ads</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-slate text-white"><i class="bi bi-briefcase"></i></div>
                <div class="stat-value">@Model.DeactiveJobAdsCount</div>
                <div class="stat-label">Inactive Job Ads</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-sky text-white"><i class="bi bi-building"></i></div>
                <div class="stat-value">@Model.EmployersCount</div>
                <div class="stat-label">Employers</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-emerald text-white"><i class="bi bi-people"></i></div>
                <div class="stat-value">@Model.JObSeekersCount</div>
                <div class="stat-label">Job Seekers</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-amber text-white"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-value">@Model.EmployerIsNotApprovedCount</div>
                <div class="stat-label">Pending Companies</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-rose text-white"><i class="bi bi-send"></i></div>
                <div class="stat-value">@Model.SubmittedAppsCount</div>
                <div class="stat-label">Submitted Applications</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-sky text-white"><i class="bi bi-search"></i></div>
                <div class="stat-value">@Model.InReviewAppsCount</div>
                <div class="stat-label">In Review</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-icon bg-gradient-indigo text-white"><i class="bi bi-camera-reels"></i></div>
                <div class="stat-value">@Model.InterviewAppsCount</div>
                <div class="stat-label">Interviews</div>
            </div>
        </div>
    </div>
</div>
