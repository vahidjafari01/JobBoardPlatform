@model List<JobBoardPlatfomr.Services.OutPutDtos.JobAdDto>
@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h4><i class="bi bi-speedometer2 me-2 text-primary"></i>My Job Ads</h4>
        <span class="text-muted small">Manage your posted opportunities</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Employer" asp-action="Company" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-building me-1"></i>My Company</a>
        <a asp-controller="Employer" asp-action="CreateJob" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i>New Job Ad</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-briefcase" style="font-size:3rem; color:#cbd5e1;"></i>
            <h5 class="mt-3">No job ads yet</h5>
            <p class="text-muted mb-3">Create your first job ad to start receiving applications.</p>
            <a asp-controller="Employer" asp-action="CreateJob" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i>Create Job Ad</a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Salary</th>
                        <th>Status</th>
                        <th>Featured</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ad in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@ad.Title</td>
                            <td><span class="badge text-bg-light text-muted">@ad.EmployementType</span></td>
                            <td class="text-muted">@(ad.SalaryMin.HasValue && ad.SalaryMax.HasValue ? $"{ad.SalaryMin.Value:N0} - {ad.SalaryMax.Value:N0}" : "Negotiable")</td>
                            <td><span class="badge text-bg-@(ad.Status == "Active" ? "success" : "secondary")">@ad.Status</span></td>
                            <td>
                                @if (ad.IsFeatured)
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-star-fill me-1"></i>Featured</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end" style="white-space:nowrap;">
                                <a asp-controller="Employer" asp-action="Applications" asp-route-jobAdId="@ad.JobAdId" class="btn btn-sm btn-outline-info rounded-pill">Applications</a>
                                <a asp-controller="Employer" asp-action="EditJob" asp-route-id="@ad.JobAdId" class="btn btn-sm btn-outline-primary rounded-pill">Edit</a>
                                <form method="post" asp-controller="Employer" asp-action="ActivateJob" asp-route-jobId="@ad.JobAdId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">Activate</button>
                                </form>
                                <form method="post" asp-controller="Employer" asp-action="ArchiveJob" asp-route-jobId="@ad.JobAdId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill">Archive</button>
                                </form>
                                <form method="post" asp-controller="Employer" asp-action="MakePro" asp-route-jobId="@ad.JobAdId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill">Pro</button>
                                </form>
                                <form method="post" asp-controller="Employer" asp-action="MakePlus" asp-route-jobId="@ad.JobAdId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill">Plus</button>
                                </form>
                                <form method="post" asp-controller="Employer" asp-action="DeleteJob" asp-route-jobAdId="@ad.JobAdId" class="d-inline" onsubmit="return confirm('Delete this job ad?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
