@model CompanyFormViewModel
@{
    ViewData["Title"] = "Create Company";
    var cities = (List<SelectListItem>)ViewData["Cities"]!;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <div class="mx-auto mb-3" style="width:70px; height:70px; border-radius:1.2rem; background:var(--brand-light); display:grid; place-items:center;">
                        <i class="bi bi-buildings" style="font-size:1.8rem; color:var(--brand);"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Create Your Company</h4>
                    <p class="text-muted mb-0">Your company will be reviewed by an admin before you can publish job ads.</p>
                </div>
                <form method="post" asp-controller="Employer" asp-action="CreateCompany">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Acme Inc." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tell applicants what your company does..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Website" class="form-label"></label>
                            <input asp-for="Website" class="form-control" placeholder="https://..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CityId" class="form-label"></label>
                            <select asp-for="CityId" class="form-select" asp-items="cities">
                                <option value="">Select City</option>
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="Full address (at least 10 characters)" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Create Company</button>
                </form>
            </div>
        </div>
    </div>
</div>
